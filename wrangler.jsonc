{
  // Cloudflare Workers config (free plan): static page + /api + hourly backup-queue tick
  "name": "thu-bros",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "SOHBET", "id": "d4cb6277155b4e62afb8a78f488be349" }],
  "triggers": { "crons": ["0 * * * *"] },
  // Workers AI (free daily allowance): Whisper transcription + gpt-oss-120b summaries
  "ai": { "binding": "AI" },
  // D1 (free): chat messages
  "d1_databases": [{ "binding": "DB", "database_name": "thu-bros-db", "database_id": "4da7a3e5-8203-4c04-af28-9bca5452f267" }],
  // Optional later: an ANTHROPIC_API_KEY secret switches summaries to Claude;
  // R2 audio storage: "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "thu-bros-media" }]
  "workers_dev": true,
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
